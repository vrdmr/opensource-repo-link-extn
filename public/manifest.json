{
  "manifest_version": 3,
  "name": "Open Source Portal Link",
  "version": "0.2.0",
  "description": "Microsoft Edge: open portal Overview/JIT for supported GitHub repos, or return to GitHub from the portal.",
  "minimum_chrome_version": "123",
  "permissions": ["activeTab", "contextMenus"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Source Portal or GitHub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+O",
        "mac": "Alt+Shift+O"
      }
    }
  }
}
